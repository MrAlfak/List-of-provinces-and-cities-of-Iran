# Auto detect text files and perform LF normalization
* text=auto

# JSON files
*.json text eol=lf

# Python files
*.py text eol=lf

# JavaScript files
*.js text eol=lf

# Markdown files
*.md text eol=lf

# SQL files
*.sql text eol=lf

# CSV files
*.csv text eol=lf

# GeoJSON files
*.geojson text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Generated dataset artifacts. Marking these as generated keeps GitHub's
# language bar focused on the implementation rather than large SQL/data dumps.
iran_cities.json linguist-generated=true
iran_cities.min.json linguist-generated=true
iran_cities.csv linguist-generated=true
iran_cities.geojson linguist-generated=true
iran_cities.mysql.sql linguist-generated=true
iran_cities.postgresql.sql linguist-generated=true
data/audit-report.json linguist-generated=true
data/excluded-urban-subareas-1402.json linguist-generated=true
