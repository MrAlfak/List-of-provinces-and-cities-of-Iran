{
  "name": "iran-cities-data",
  "version": "2.1.0",
  "description": "Source-backed Iran provinces and cities dataset: 31 provinces, 1450 cities, JSON, CSV, GeoJSON, MySQL, PostgreSQL and REST API",
  "main": "iran_cities.json",
  "types": "index.d.ts",
  "files": [
    "iran_cities.json",
    "iran_cities.min.json",
    "iran_cities.csv",
    "iran_cities.geojson",
    "iran_cities.mysql.sql",
    "iran_cities.postgresql.sql",
    "index.d.ts",
    "README.md",
    "README.fa.md",
    "DATA_LICENSE.md",
    "LICENSE-DATA-GPL-3.0",
    "data/provenance.json"
  ],
  "scripts": {
    "test": "python -m pytest tests/",
    "validate": "python scripts/validate_data.py && python scripts/audit_data.py --strict",
    "generate": "python scripts/generate_all.py",
    "prepublishOnly": "npm run validate && npm test && npm run generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrAlfak/List-of-provinces-and-cities-of-Iran.git"
  },
  "keywords": [
    "iran",
    "iran-cities",
    "iran-provinces",
    "iranian-cities",
    "iranian-provinces",
    "cities",
    "provinces",
    "persian",
    "farsi",
    "json",
    "csv",
    "geojson",
    "mysql",
    "postgresql",
    "rest-api",
    "location-data",
    "geodata",
    "administrative-divisions",
    "address-data",
    "tehran"
  ],
  "author": "MrAlfak",
  "license": "SEE LICENSE IN DATA_LICENSE.md",
  "bugs": {
    "url": "https://github.com/MrAlfak/List-of-provinces-and-cities-of-Iran/issues"
  },
  "homepage": "https://github.com/MrAlfak/List-of-provinces-and-cities-of-Iran#readme"
}
