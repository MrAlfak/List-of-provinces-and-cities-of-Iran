{
  "name": "iran-cities-data",
  "version": "2.1.0",
  "description": "Iran provinces/cities dataset with provenance-aware tooling and multiple derived formats",
  "main": "iran_cities.json",
  "types": "index.d.ts",
  "scripts": {
    "validate": "python scripts/validate_data.py",
    "audit": "python scripts/audit_data.py",
    "test": "python -m pytest tests/",
    "generate": "python scripts/generate_all.py",
    "prepack": "python scripts/validate_data.py && python -m pytest tests/ && python scripts/generate_all.py",
    "serve": "python api_server.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrAlfak/List-of-provinces-and-cities-of-Iran.git"
  },
  "keywords": [
    "iran",
    "cities",
    "provinces",
    "geography",
    "coordinates",
    "persian",
    "farsi",
    "geojson",
    "administrative-divisions",
    "data"
  ],
  "author": "MrAlfak",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MrAlfak/List-of-provinces-and-cities-of-Iran/issues"
  },
  "homepage": "https://github.com/MrAlfak/List-of-provinces-and-cities-of-Iran#readme",
  "files": [
    "iran_cities.json",
    "iran_cities.min.json",
    "iran_cities.mysql.sql",
    "iran_cities.postgresql.sql",
    "iran_cities.csv",
    "iran_cities.geojson",
    "index.d.ts",
    "README.md",
    "README.fa.md",
    "LICENSE",
    "data/provenance.json"
  ]
}
